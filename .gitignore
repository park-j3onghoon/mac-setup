# macOS
.DS_Store

# IDE
.idea/
.vscode/

# 임시 작업 디렉토리
tmp/
*.backup

# 시크릿 (실수 방지)
# 이 레포에는 원칙적으로 시크릿 파일을 두지 않지만, 실수로 들어와도 차단.
*.env
*.pem
*.key
linear_api_key
redash_config.json
auth.json
installation_id

# 회사 전용 설정 (공개 레포라 커밋하지 않는다)
# 이 트리는 install.sh 가 심링크로 배포하고, git 은 전혀 추적하지 않는다.
# 나중에 백업이 필요하면 이 디렉토리에서 git init 후 private 리모트만 붙이면 된다.
/private/

# 업무 맥락이 본문에 들어간 개인 규칙 파일. 파일명 자체가 단서가 되는 것들은
# 여기 적지 않고 .git/info/exclude (커밋되지 않는 로컬 전용 제외 목록) 에 둔다.
/claude/lib/review/team.md
