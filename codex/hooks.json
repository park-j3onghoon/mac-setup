{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/git/mac-setup/codex/hooks/permissions.py\"",
            "timeout": 5,
            "statusMessage": "Claude 차단 규칙 및 승인 예외"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-dangerous-git.sh\"",
            "timeout": 5,
            "statusMessage": "Claude와 동일한 위험 Git 명령 차단"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/git/athena-guard/bin/bash-hook.sh\"",
            "timeout": 15,
            "statusMessage": "athena-guard(Bash의 Redash·Athena 직접 호출)"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/git/mac-setup/codex/hooks/permissions.py\"",
            "timeout": 5,
            "statusMessage": "Claude 차단 규칙 및 승인 예외"
          }
        ]
      }
    ]
  }
}
