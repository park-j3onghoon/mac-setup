{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "mcp__plugin_slack_slack__slack_read_canvas",
      "mcp__plugin_slack_slack__slack_read_channel",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_slack_slack__slack_read_user_profile",
      "mcp__plugin_slack_slack__slack_search_channels",
      "mcp__plugin_slack_slack__slack_search_public",
      "mcp__plugin_slack_slack__slack_search_public_and_private",
      "mcp__plugin_slack_slack__slack_search_users",
      "mcp__linear-server__*",
      "mcp__Linear__get_attachment",
      "mcp__Linear__get_document",
      "mcp__Linear__get_initiative",
      "mcp__Linear__get_issue",
      "mcp__Linear__get_issue_status",
      "mcp__Linear__get_milestone",
      "mcp__Linear__get_project",
      "mcp__Linear__get_status_updates",
      "mcp__Linear__get_team",
      "mcp__Linear__get_user",
      "mcp__Linear__list_comments",
      "mcp__Linear__list_cycles",
      "mcp__Linear__list_documents",
      "mcp__Linear__list_initiatives",
      "mcp__Linear__list_issue_labels",
      "mcp__Linear__list_issue_statuses",
      "mcp__Linear__list_issues",
      "mcp__Linear__list_milestones",
      "mcp__Linear__list_project_labels",
      "mcp__Linear__list_projects",
      "mcp__Linear__list_teams",
      "mcp__Linear__list_users",
      "mcp__Linear__search_documentation",
      "mcp__Linear__extract_images",
      "mcp__plugin_sentry_sentry__analyze_issue_with_seer",
      "mcp__plugin_sentry_sentry__find_organizations",
      "mcp__plugin_sentry_sentry__find_projects",
      "mcp__plugin_sentry_sentry__find_releases",
      "mcp__plugin_sentry_sentry__find_teams",
      "mcp__plugin_sentry_sentry__get_doc",
      "mcp__plugin_sentry_sentry__get_event_attachment",
      "mcp__plugin_sentry_sentry__get_issue_details",
      "mcp__plugin_sentry_sentry__get_issue_tag_values",
      "mcp__plugin_sentry_sentry__get_trace_details",
      "mcp__plugin_sentry_sentry__search_docs",
      "mcp__plugin_sentry_sentry__search_events",
      "mcp__plugin_sentry_sentry__search_issue_events",
      "mcp__plugin_sentry_sentry__search_issues",
      "mcp__plugin_sentry_sentry__whoami",
      "mcp__Datadog__check_datadog_mcp_setup"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"구현 전에 /plan-review 를 실행했나요?\"}}'",
            "timeout": 5,
            "statusMessage": "계획 리뷰 확인"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/block-dangerous-git.sh",
            "timeout": 5,
            "statusMessage": "되돌릴 수 없는 git 명령 차단"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | tr '\\\\\\n' '  ' | grep -qE 'git([[:space:]]+-[^[:space:]]+([[:space:]]+(\"[^\"]*\"|[^-[:space:]][^[:space:]]*))?)*[[:space:]]+push|gh[[:space:]]+pr[[:space:]]+create' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"리뷰 전 Draft PR을 처음 올리는 push면 그대로 진행하세요. 리뷰 반영분 push면 /implement-review 를 마쳤나요? 인증·권한·시크릿·결제 변경이면 /cso 도.\"}}'; true",
            "timeout": 5,
            "statusMessage": "push/PR 사전 체크"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/refresh-session-continue.sh",
            "timeout": 10,
            "statusMessage": "/refresh-session 다음 명령 입력"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": false,
    "everything-claude-code@everything-claude-code": false,
    "slack@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light-daltonized"
}
