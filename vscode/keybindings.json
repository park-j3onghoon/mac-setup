// VSCode 키바인딩 (PyCharm 스타일)
// 실 위치: ~/Library/Application Support/Code/User/keybindings.json (이 파일에 symlink)
[
  // ───── 1. Cmd+B: 정의로 이동 ─────
  // settings.json의 alternativeDefinitionCommand로 폴백 시도하지만
  // Kotlin LSP는 폴백 미지원 → 사용처는 Cmd+Shift+B로 별도 키 사용
  {
    "key": "cmd+b",
    "command": "editor.action.revealDefinition",
    "when": "editorTextFocus"
  },

  // ───── 1-B. Cmd+Shift+B: 사용처 찾기 (peek view = PyCharm 스타일) ─────
  {
    "key": "cmd+shift+b",
    "command": "editor.action.peekReferences",
    "when": "editorTextFocus"
  },
  // 기본 'Run Build Task' 비활성화 (충돌 방지)
  {
    "key": "cmd+shift+b",
    "command": "-workbench.action.tasks.build"
  },

  // ───── 2-A. Cmd+1: Explorer 토글 (PyCharm 스타일) ─────
  {
    "key": "cmd+1",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "explorerViewletVisible && sideBarFocus"
  },
  {
    "key": "cmd+1",
    "command": "workbench.view.explorer",
    "when": "!(explorerViewletVisible && sideBarFocus)"
  },
  // 기본 'Focus First Editor Group' 비활성화 (충돌 방지)
  {
    "key": "cmd+1",
    "command": "-workbench.action.focusFirstEditorGroup"
  },

  // ───── 2-B. Cmd+2: Git(SCM) 패널 토글 ─────
  {
    "key": "cmd+2",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "scmViewletVisible && sideBarFocus"
  },
  {
    "key": "cmd+2",
    "command": "workbench.view.scm",
    "when": "!(scmViewletVisible && sideBarFocus)"
  },
  {
    "key": "cmd+2",
    "command": "-workbench.action.focusSecondEditorGroup"
  },

  // ───── 3. Cmd+Shift+Backspace: 마지막 편집 위치로 점프 ─────
  {
    "key": "cmd+shift+backspace",
    "command": "workbench.action.navigateToLastEditLocation"
  },

  // ───── 4. Cmd+Shift+[ / Cmd+Shift+]: 탭 좌우 이동 ─────
  {
    "key": "cmd+shift+[",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "cmd+shift+]",
    "command": "workbench.action.nextEditor"
  },

  // ───── 5. Cmd+Esc: 사이드바 + 하단 패널 한 번에 토글 ─────
  // multi-command 확장 사용 (interval 50ms로 두 명령 누락 방지)
  // 케이스 ①: 둘 다 보임 → 한 번에 둘 다 닫기
  {
    "key": "cmd+escape",
    "command": "extension.multiCommand.execute",
    "args": { "command": "multiCommand.toggleSidebarAndPanel" },
    "when": "sideBarVisible && panelVisible"
  },
  // 케이스 ②: 사이드바만 보임 → 사이드바 닫기
  {
    "key": "cmd+escape",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "sideBarVisible && !panelVisible"
  },
  // 케이스 ③: 패널만 보임 → 패널 닫기
  {
    "key": "cmd+escape",
    "command": "workbench.action.togglePanel",
    "when": "!sideBarVisible && panelVisible"
  },
  // 케이스 ④: 둘 다 닫힘 → 둘 다 다시 열기
  {
    "key": "cmd+escape",
    "command": "extension.multiCommand.execute",
    "args": { "command": "multiCommand.toggleSidebarAndPanel" },
    "when": "!sideBarVisible && !panelVisible"
  },

  // ───── 6. Cmd+4: 터미널 토글 ─────
  {
    "key": "cmd+4",
    "command": "workbench.action.terminal.toggleTerminal"
  },
  // 기본 'Focus Fourth Editor Group' 비활성화
  {
    "key": "cmd+4",
    "command": "-workbench.action.focusFourthEditorGroup"
  },

  // ───── 7. Cmd+3: Python REPL (PyCharm의 Python Console) ─────
  // 터미널 REPL(python.startREPL)이 아닌 Native REPL — Cmd+4 터미널과 영역이 겹치지 않게
  {
    "key": "cmd+3",
    "command": "python.startNativeREPL"
  },
  {
    "key": "cmd+3",
    "command": "-workbench.action.focusThirdEditorGroup"
  },

  // ───── 8. Cmd+5: 에디터로 포커스 (PyCharm FocusEditor) ─────
  {
    "key": "cmd+5",
    "command": "workbench.action.focusActiveEditorGroup"
  },
  {
    "key": "cmd+5",
    "command": "-workbench.action.focusFifthEditorGroup"
  },

  // ───── 9. Cmd+Shift+- / Cmd+Shift+=: 모두 접기 / 모두 펼치기 ─────
  // PyCharm 커스텀 키맵은 숫자패드 -(subtract)를 썼으나 맥북 내장 키보드엔
  // 숫자패드가 없어 눌리지 않는다. PyCharm 원래 기본값인 Cmd+Shift+-로 되돌림.
  {
    "key": "cmd+shift+-",
    "command": "editor.foldAll",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+shift+=",
    "command": "editor.unfoldAll",
    "when": "editorTextFocus"
  },
  // 창 줌은 Cmd+= / Cmd+- 주 바인딩으로 유지하고, 보조 바인딩만 비워 충돌을 막는다
  {
    "key": "cmd+shift+=",
    "command": "-workbench.action.zoomIn"
  },
  {
    "key": "cmd+shift+-",
    "command": "-workbench.action.zoomOut"
  }
]
