{
  "redhat.telemetry.enabled": true,
  "window.systemColorTheme": "light",
  "window.autoDetectColorScheme": true,
  "editor.minimap.enabled": false,
  "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.goToReferences",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleReferences": "peek",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  "workbench.list.openMode": "singleClick",
  "explorer.autoReveal": true,
  "multiCommand.commands": [
    {
      "command": "multiCommand.toggleSidebarAndPanel",
      "interval": 50,
      "sequence": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.togglePanel"
      ]
    }
  ],
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
      "default": true
    }
  ],
  "java.jdt.ls.java.home": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
  "java.import.gradle.java.home": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,
  "java.compile.nullAnalysis.mode": "automatic",
  "kotlin.languageServer.enabled": true,
  "kotlin.compiler.jvm.target": "21",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.useFlatConfig": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.analysis.typeCheckingMode": "basic",
  "[kotlin]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4
  },
  "[java]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4
  },
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/.turbo": true,
    "**/.next": true,
    "**/dist": true,
    "**/.expo": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/.turbo": true,
    "**/.next": true,
    "**/dist": true,
    "**/.expo": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "**/*.tsbuildinfo": true
  },
  "files.watcherExclude": {
    "**/.gradle/**": true,
    "**/build/**": true,
    "**/.turbo/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .npmrc, .nvmrc, tsconfig*.json, turbo.json",
    "next.config.*": "next-env.d.ts, postcss.config.*, tailwind.config.*",
    "*.ts": "${capture}.test.ts, ${capture}.spec.ts",
    "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx",
    "*.kt": "${capture}Test.kt"
  },
  "editor.rulers": [
    100
  ],
  "editor.tabSize": 2,
  "editor.fontSize": 22,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.semanticHighlighting.enabled": true,
  "java.semanticHighlighting.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.matchBrackets": "always",
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": "always",
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": true,
  "editor.renderWhitespace": "boundary",
  "editor.renderLineHighlight": "all",
  "editor.showUnused": true,
  "java.completion.importOrder": [
    "java",
    "javax",
    "org",
    "com",
    ""
  ],
  "workbench.colorTheme": "Solarized Light",
  "workbench.preferredLightColorTheme": "Solarized Light",
  "workbench.preferredDarkColorTheme": "One Dark Pro",
  "workbench.colorCustomizations": {
    "[Solarized Light]": {
      "editor.background": "#EEE8D5",
      "editor.foreground": "#323D42",
      "editorCursor.foreground": "#323D42",
      "editorLineNumber.foreground": "#9AA6A6",
      "editorLineNumber.activeForeground": "#323D42",
      "editor.lineHighlightBackground": "#E3DCC6",
      "editor.selectionBackground": "#D3CBB0",
      "editorIndentGuide.background1": "#D8D1BB",
      "editorIndentGuide.activeBackground1": "#B8AE92"
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "function": {
        "foreground": "#5257B9",
        "fontStyle": "bold"
      },
      "method": {
        "foreground": "#5257B9",
        "fontStyle": "bold"
      },
      "function.defaultLibrary": {
        "foreground": "#5257B9"
      },
      "*.declaration": {
        "fontStyle": "bold"
      }
    },
    "[One Dark Pro]": {
      "enabled": true,
      "rules": {
        "function": {
          "foreground": "#61AFEF",
          "fontStyle": "bold"
        },
        "method": {
          "foreground": "#61AFEF",
          "fontStyle": "bold"
        },
        "function.defaultLibrary": {
          "foreground": "#61AFEF"
        },
        "*.declaration": {
          "fontStyle": "bold"
        }
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "[Solarized Light]": {
      "comments": "#5C6A6A",
      "strings": "#1C6C66",
      "keywords": "#5B6800",
      "numbers": "#B3276B",
      "types": "#7B5D00",
      "functions": "#5257B9",
      "variables": "#323D42"
    },
    "textMateRules": [
      {
        "scope": [
          "entity.name.function",
          "entity.name.function.kotlin",
          "entity.name.function.java",
          "support.function",
          "meta.function-call entity.name.function"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      }
    ]
  },
  "sqltools.disableChordKeybindings": true,
  "sqltools.results.location": "next",
  "sqltools.results.limit": 200,
  "sqltools.results.reuseTabs": "connection",
  "sqltools.autoOpenSessionFiles": false,
  "sqltools.disableReleaseNotifications": true,
  "sqltools.connectionExplorer.groupConnected": true
}
