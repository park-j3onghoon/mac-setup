{
    // ───────── 외관 / 텔레메트리 ─────────
    "redhat.telemetry.enabled": true,
    "window.systemColorTheme": "light",
    "window.autoDetectColorScheme": true,
    "editor.minimap.enabled": false,

    // ───────── PyCharm 스타일 Cmd+B (정의 ↔ 사용처 자동 토글) ─────────
    // "Go to Definition"이 결과를 못 찾으면 (= 이미 정의 위에 있으면) "Find References"로 폴백
    "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.goToReferences",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleReferences": "goto",

    // ───────── 에디터 탭 / 클릭 동작 ─────────
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.enablePreviewFromCodeNavigation": false,
    "workbench.list.openMode": "singleClick",
    "explorer.autoReveal": true,

    // ───────── multi-command 확장 정의 (Cmd+Esc 키바인딩에서 사용) ─────────
    "multiCommand.commands": [
        {
            "command": "multiCommand.toggleSidebarAndPanel",
            "interval": 50,
            "sequence": [
                "workbench.action.toggleSidebarVisibility",
                "workbench.action.togglePanel"
            ]
        }
    ],

    // ───────── Java / Kotlin / Gradle ─────────
    // Brewfile에서 cask "temurin@21" 설치 시 이 경로에 위치
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
            "default": true
        }
    ],
    "java.jdt.ls.java.home": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
    "java.import.gradle.java.home": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
    "java.import.gradle.enabled": true,
    "java.import.gradle.wrapper.enabled": true,
    "java.compile.nullAnalysis.mode": "automatic",

    "kotlin.languageServer.enabled": true,
    "kotlin.compiler.jvm.target": "21",

    // ───────── TypeScript / JavaScript ─────────
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.useFlatConfig": true,

    // ───────── 언어별 포매터 ─────────
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "python.analysis.typeCheckingMode": "basic",

    "[kotlin]": {
        "editor.formatOnSave": false,
        "editor.tabSize": 4
    },
    "[java]": {
        "editor.formatOnSave": false,
        "editor.tabSize": 4
    },

    // ───────── 탐색기 / 검색 / 파일 와처 제외 ─────────
    "files.exclude": {
        "**/.gradle": true,
        "**/build": true,
        "**/.turbo": true,
        "**/.next": true,
        "**/dist": true,
        "**/.expo": true,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/.gradle": true,
        "**/build": true,
        "**/.turbo": true,
        "**/.next": true,
        "**/dist": true,
        "**/.expo": true,
        "**/node_modules": true,
        "**/package-lock.json": true,
        "**/*.tsbuildinfo": true
    },
    "files.watcherExclude": {
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/.turbo/**": true,
        "**/.next/**": true,
        "**/node_modules/**": true
    },

    // ───────── 파일 중첩 ─────────
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "package.json": "package-lock.json, .npmrc, .nvmrc, tsconfig*.json, turbo.json",
        "next.config.*": "next-env.d.ts, postcss.config.*, tailwind.config.*",
        "*.ts": "${capture}.test.ts, ${capture}.spec.ts",
        "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx",
        "*.kt": "${capture}Test.kt"
    },

    // ───────── 에디터 공통 ─────────
    "editor.rulers": [100],
    "editor.tabSize": 2,
    "editor.fontSize": 22,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    // ───────── 코드 가독성 / 하이라이팅 (Java/Kotlin 등 모든 언어) ─────────
    // 의미론 컬러링: 변수/함수/클래스/파라미터 등을 역할별로 색 구분 (LSP 기반)
    "editor.semanticHighlighting.enabled": true,
    "java.semanticHighlighting.enabled": true,

    // 괄호 짝 색상화: ( ) { } [ ] 중첩을 색으로 구분
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.bracketPairsHorizontal": "active",
    "editor.matchBrackets": "always",

    // 들여쓰기 가이드 강조
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": "always",

    // 커서 주변 같은 식별자 자동 강조
    "editor.occurrencesHighlight": "singleFile",

    // 같은 단어 선택 시 모두 표시
    "editor.selectionHighlight": true,

    // 공백 문자 표시 (단어 경계만 — 너무 시끄럽지 않게)
    "editor.renderWhitespace": "boundary",

    // 현재 라인 강조 (배경 + 거터)
    "editor.renderLineHighlight": "all",

    // 미사용 import / 변수 흐리게 표시
    "editor.showUnused": true,

    // 자동 import 추가
    "java.completion.importOrder": ["java", "javax", "org", "com", ""],

    // ───────── 테마 (시스템 라이트/다크에 따라 자동 전환) ─────────
    // window.autoDetectColorScheme: true → 시스템 모드 따라 preferred*ColorTheme 적용
    // workbench.colorTheme도 명시 (auto-detect 미작동 시 fallback)
    "workbench.colorTheme": "Solarized Light",
    "workbench.preferredLightColorTheme": "Solarized Light",
    "workbench.preferredDarkColorTheme": "One Dark Pro",

    // ───────── 눈 피로 보정 (밝은 실내 + 라이트 테마) ─────────
    // Solarized 는 "최소 대비"가 설계 의도라 본문 4.13:1 / 주석 2.48:1 로
    // WCAG AA(4.5:1) 에 못 미친다. 흐린 글자를 해상하려 눈이 계속 애쓰는 게 피로의 주범.
    // 배경은 base3→base2 로 한 톤 낮춰(휘도 92%→81%) 눈부심을 줄이고,
    // 전경은 색상(hue)은 그대로 두고 명도만 내려 전 토큰을 AA 위로 올린다.
    // 다크 테마로 가지 않는 이유: 밝은 실내에선 화면·주변 휘도 차가 커져 오히려 역효과.
    "workbench.colorCustomizations": {
        "[Solarized Light]": {
            "editor.background": "#EEE8D5",
            "editor.foreground": "#323D42",
            "editorCursor.foreground": "#323D42",
            "editorLineNumber.foreground": "#9AA6A6",
            "editorLineNumber.activeForeground": "#323D42",
            "editor.lineHighlightBackground": "#E3DCC6",
            "editor.selectionBackground": "#D3CBB0",
            "editorIndentGuide.background1": "#D8D1BB",
            "editorIndentGuide.activeBackground1": "#B8AE92"
        }
    },

    // ───────── 함수/메서드만 색으로 구분 ─────────
    // 파라미터·프로퍼티·타입까지 색을 주면 코드의 대부분이 물들어 오히려 구분이 사라진다.
    // 색은 함수/메서드 한 축에만 쓰고, 선언부는 색 없이 굵기로만 구분한다.
    // Solarized 기본 blue(#268BD2)는 배경 대비 3.41:1 로 미달이고 theme 이 변수에도
    // 쓰는 색이라 충돌한다 → 명도를 낮춘 violet 계열로 교체(5.01:1, 본문과 명도차 1.82:1).
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "function": { "foreground": "#5257B9", "fontStyle": "bold" },
            "method": { "foreground": "#5257B9", "fontStyle": "bold" },
            "function.defaultLibrary": { "foreground": "#5257B9" },
            "*.declaration": { "fontStyle": "bold" }
        },
        "[One Dark Pro]": {
            "enabled": true,
            "rules": {
                "function": { "foreground": "#61AFEF", "fontStyle": "bold" },
                "method": { "foreground": "#61AFEF", "fontStyle": "bold" },
                "function.defaultLibrary": { "foreground": "#61AFEF" },
                "*.declaration": { "fontStyle": "bold" }
            }
        }
    },

    "editor.tokenColorCustomizations": {
        // Solarized Light 토큰색은 전부 3:1 안팎이라 배경과 뭉갠다.
        // 색상은 유지하고 명도만 내려 ≥4.6:1 로 올린 값.
        "[Solarized Light]": {
            "comments": "#5C6A6A",
            "strings": "#1C6C66",
            "keywords": "#5B6800",
            "numbers": "#B3276B",
            "types": "#7B5D00",
            "functions": "#5257B9",
            "variables": "#323D42"
        },
        // TextMate 스코프 fallback (LSP 의미 토큰이 없는 부분 대비)
        "textMateRules": [
            {
                "scope": [
                    "entity.name.function",
                    "entity.name.function.kotlin",
                    "entity.name.function.java",
                    "support.function",
                    "meta.function-call entity.name.function"
                ],
                "settings": { "fontStyle": "bold" }
            }
        ]
    }
}
